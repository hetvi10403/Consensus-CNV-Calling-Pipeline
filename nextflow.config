nextflow.enable.dsl=2

conda.enabled = true

// Point these at your own conda environments (name or full path),
// or at the images built from docker/ if you use -profile docker.
params.conda_gatk_env   = "gatk_cd"
params.conda_cnvkit_env = "cnvkit"

params.container_gatk_env   = "cnv-pipeline-gatk_cd:latest"
params.container_cnvkit_env = "cnv-pipeline-cnvkit:latest"

process {

	executor = 'local'

	withName: INDEX_BAM {
		cpus = 4
		memory = '8 GB'
		conda = params.conda_gatk_env
		container = params.container_gatk_env
	}

	withName: CLEAN_BAM {
		cpus = 4
		memory = '16 GB'
		conda = params.conda_gatk_env
		container = params.container_gatk_env
	}

	withName: CNVPYTOR {
		cpus = 8
		memory = '32 GB'
		conda = params.conda_gatk_env
		container = params.container_gatk_env
	}

	withName: CNVKIT {
		cpus = 8
		memory = '32 GB'
		conda = params.conda_cnvkit_env
		container = params.container_cnvkit_env
	}

	withName: READCOUNTER {
		cpus = 8
		memory = '32 GB'
		conda = params.conda_gatk_env
		container = params.container_gatk_env
	}

	withName: ICHORCNA {
		cpus = 8
		memory = '64 GB'
		conda = params.conda_gatk_env
		container = params.container_gatk_env
	}

	withName: MERGE_CNVS {
		cpus = 2
		memory = '8 GB'
		conda = params.conda_gatk_env
		container = params.container_gatk_env
	}

	withName: ANNOTSV {
		cpus = 2
		memory = '8 GB'
		conda = params.conda_cnvkit_env
		container = params.container_cnvkit_env
	}

}

profiles {

	// Default: use conda environments (see params.conda_* above)
	conda {
		conda.enabled = true
		docker.enabled = false
	}

	// Use Docker images built from docker/*.Dockerfile instead of conda
	docker {
		docker.enabled = true
		conda.enabled  = false
	}

	// Fast wiring/syntax validation with tiny placeholder data, used in CI.
	// Combine with `-stub-run` so no real tool needs to be installed.
	test {
		params.sample_sheet = "${projectDir}/test-data/samplesheet.csv"
		params.centromere   = "${projectDir}/resources/centromere_plus_nogenes.bed"
		params.output_dir   = "test-results"
		params.bin_size     = 50000
		conda.enabled       = false
		docker.enabled      = false

		// override the real resource requests (4-8 cpus, up to 64 GB) with
		// something any CI runner can satisfy, since stub tasks are just `touch`
		process {
			withName: '.*' {
				cpus   = 1
				memory = '256 MB'
			}
		}
	}
}

timeline {
	enabled = true
	file = "timeline.html"
}
report {
	enabled = true
	file = "report.html"
}
trace {
	enabled = true
	file = "trace.txt"
}
dag {
	enabled = true
	file = "dag.png"
}

